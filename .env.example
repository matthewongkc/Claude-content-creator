# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is gitignored — your keys never get committed.
# ─────────────────────────────────────────────────────────────

# --- Claude (content generation) ---------------------------------
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Instagram Graph API (auto-posting) --------------------------
# You need an Instagram *Business* or *Creator* account linked to a
# Facebook Page, plus a Meta app with a long-lived access token.
# See README.md → "Setting up Instagram auto-posting".
IG_USER_ID=1784xxxxxxxxxxx
IG_ACCESS_TOKEN=EAAG...

# --- Image hosting -----------------------------------------------
# Instagram's Graph API fetches slide images by public URL, so the
# rendered PNGs must be reachable on the internet. Pick ONE backend.
# Options: "github", "cloudinary", "imgbb".
IMAGE_HOST=github

# github (free, no extra signup): commits slides to a PUBLIC repo and
# serves them via raw.githubusercontent.com. The repo MUST be public.
# Token: a PAT with Contents read/write on that repo
#   - Fine-grained: Repository access → the repo → Contents: Read and write
#   - Classic: "repo" scope
GITHUB_TOKEN=
GITHUB_IMAGE_REPO=your-username/your-public-image-repo
GITHUB_IMAGE_BRANCH=main
GITHUB_IMAGE_DIR=carousels

# Cloudinary (alternative): https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# imgbb (alternative; the API key is free): https://api.imgbb.com/
IMGBB_API_KEY=

# --- Dashboard ---------------------------------------------------
# Any random string; used to sign Flask sessions.
DASHBOARD_SECRET=change-me-to-something-random
